{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand AI-Readiness Audit Report",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "properties": {
    "site":       { "type": "string" },
    "audited_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium"],
      "properties": {
        "total_findings":  { "type": "integer", "description": "Equals len(findings[]); active/latent sub-counts follow" },
        "critical":        { "type": "integer" },
        "high":            { "type": "integer" },
        "medium":          { "type": "integer" },
        "low":             { "type": "integer" },
        "info":            { "type": "integer" },
        "latent_findings": { "type": "integer", "description": "real findings currently unobservable behind an access blocker" },
        "run_status":      { "enum": ["complete", "partial", "blocked", "failed"] },
        "headline":        { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "evidence", "suggested_action"],
        "properties": {
          "id":       { "type": "string", "pattern": "^F-[0-9]{3}$" },
          "title":    { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "evidence": { "type": "string", "description": "reproducible; names what was checked, what was found, and how to confirm" },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "properties": {
              "summary":  { "type": "string" },
              "priority": { "enum": ["critical", "high", "medium", "low"] },
              "effort":   { "enum": ["low", "medium", "high"] },
              "how":      { "type": "array", "items": { "type": "string" } },
              "verify":   { "type": "string", "description": "how to confirm the fix worked" }
            }
          },
          "check_id":            { "type": "string" },
          "gate":                { "enum": ["access", "extractability", "interpretability", "freshness", "engagement", "unknown"] },
          "mechanism":           { "type": "string" },
          "status":              { "enum": ["active", "latent"] },
          "confidence":          { "enum": ["deterministic", "heuristic"] },
          "measurement_basis":   { "enum": ["static_fact", "static_heuristic"] },
          "blast_radius":        { "enum": ["site_wide", "template", "single_page"] },
          "severity_rationale":  { "type": "string", "description": "the arithmetic behind the severity, auditable" },
          "affected_urls":       { "type": "array", "items": { "type": "string" } },
          "affected_url_count":  { "type": "integer" },
          "blocked_by": {
            "type": "object",
            "properties": {
              "finding_check":   { "type": "string" },
              "agents_affected": { "type": "array", "items": { "type": "string" } },
              "note":            { "type": "string" }
            }
          },
          "detail": { "type": "object" }
        }
      }
    },
    "site_profile":  { "type": "object" },
    "coverage":      { "type": "object" },
    "checks_run":    { "type": "array", "items": { "type": "string" } },
    "checks_skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "reason"],
        "properties": {
          "check":  { "type": "string" },
          "reason": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    },
    "prioritized_actions":      { "type": "array" },
    "proactive_recommendations":{ "type": "array", "description": "Only recommendations the site does not already satisfy; each carries applies_because" },
    "already_in_place":         { "type": "array", "description": "Proactive recommendations the site already implements, with the evidence" },
    "limits":                   { "type": "array", "items": { "type": "string" } },
    "notes":                    { "type": "array", "items": { "type": "string" } }
  }
}
